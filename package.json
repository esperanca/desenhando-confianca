  "description": "Desenhando Confiança — livro sobre design, IA e confiança em interfaces generativas e agentes",
  "main": "index.js",
  "dependencies": {
    "@11ty/eleventy-plugin-syntaxhighlight": "^4.0.0",
    "eleventy-plugin-svg-contents": "^0.7.0",
    "html-minifier": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
