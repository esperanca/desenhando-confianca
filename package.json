  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "markdown-it-anchor": "^8.1.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.3.2"
  },
  "scripts": {
    "sass": "npx sass src/scss/style.scss src/_includes/css/style.css --style=compressed",
