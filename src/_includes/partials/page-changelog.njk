{#- Log de mudanças da página: histórico dos commits que alteraram o arquivo atual. -#}
{% set changes = page.inputPath | pageChanges %}
{% if changes and changes.groups and changes.groups.length %}
<section aria-label="Log de mudanças desta página" class="changelog changelog--page">
  <h2 id="log-de-mudancas">Log de mudanças</h2>
  <p class="changelog__intro">Histórico de alterações feitas especificamente nesta página: {{ title }}.</p>

  {% for group in changes.groups %}
  <div class="changelog__day">
    <h3 class="changelog__date"><time datetime="{{ group.key }}">{{ group.date | changeDateGroup }}</time></h3>
    <ol class="changelog__entries">
      {% for change in group.commits %}
      {% set authorUrl = change.author | authorUrl %}
      {% set changeUrl = change.hash | commitUrl(site.repositoryUrl) %}
      <li class="changelog__entry">
        <time class="changelog__time" datetime="{{ change.date }}">{{ change.date | changeTime }}</time>
        <span aria-hidden="true">—</span>
        <span class="changelog__summary">{{ change | editorialChangeLabel }}</span>
        {% if change.author %}
          {% if authorUrl %}
          <a class="changelog__author" href="{{ authorUrl }}">{{ change.author }}</a>
          {% else %}
          <span class="changelog__author">{{ change.author }}</span>
          {% endif %}
        {% endif %}
        {% if changeUrl %}
        <span aria-hidden="true"> · </span><a class="changelog__commit" href="{{ changeUrl }}">Ver alteração</a>
        {% endif %}
        {% if change.release %}
        <span aria-hidden="true"> · </span><span class="changelog__release">{{ change.release }}</span>
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
  {% endfor %}
</section>
{% endif %}