{% extends 'layouts/base.njk' %}

{% block content %}
  <main id="main-content" tabindex="-1" class="book-page">
    <article class="book-article">
      <header class="book-header">
        <p class="eyebrow">{% if type == 'note' %}Nota complementar{% else %}Desenhando Confiança{% endif %}</p>
        {% if status %}
        <p class="editorial-status">
          <span class="status-tag status-tag--{{ status }}">{{ status | statusLabel }}</span>
          <span>{{ status | statusDescription }}</span>
        </p>
        {% endif %}
        <h1>{{ title }}</h1>
        {% if subtitle %}<p class="book-subtitle">{{ subtitle }}</p>{% endif %}
        {% if summary %}<p class="book-summary">{{ summary }}</p>{% endif %}
        {% if status or dateModified %}
        <p class="book-meta">
          {% if status %}<span>{{ status | statusLabel }}</span>{% endif %}
          {% if status and dateModified %}<span aria-hidden="true"> · </span>{% endif %}
          {% if dateModified %}<time datetime="{{ dateModified }}">Atualizado em {{ dateModified | dateFilter }}</time>{% endif %}
        </p>
        {% endif %}
      </header>

      <div class="book-body">
          {{ content | safe }}
      </div>

      <footer class="book-footer">
        {% if type == 'chapter' %}<a href="/livro/">← Voltar ao sumário</a>{% else %}<a href="/">← Voltar ao início</a>{% endif %}
      </footer>
    </article>
  </main>
{% endblock %}
